{% comment %}
  When nothing passes Minimum Severity and the Pollen Filter, say why. Level 0 means no load, so with the
  default (1 and higher) "Keine Pollen" is simply true. From level 2 up, lower levels may exist but are
  hidden, so name the limit: "Keine Pollen ab Stufe 2 (mäßig)". With "show all" (0) only the filter can
  hide anything: "Keine passenden Pollen".
{% endcomment %}
{% assign t_min_level = "" %}
{% if min_severity > 1 %}
  {% assign min_severity_name = t_sev[min_severity] %}
  {% assign t_min_level = t_level_pattern | replace: "{n}", min_severity %}
  {% assign t_no_load = t_no_load_pattern | replace: "{n}", min_severity | replace: "{s}", min_severity_name %}
  {% assign t_no_load_short = t_none %}
{% elsif min_severity == 1 %}
  {% assign t_no_load = t_none %}
  {% assign t_no_load_short = t_none %}
{% else %}
  {% assign t_no_load = t_none_matching %}
  {% assign t_no_load_short = t_none_matching %}
{% endif %}
{% assign t_filter_names = "" %}
{% for f in filter_list %}
  {% assign f_clean = f | strip %}
  {% if f_clean == "" %}{% continue %}{% endif %}
  {% if t_filter_names != "" %}{% assign t_filter_names = t_filter_names | append: ", " %}{% endif %}
  {% assign t_filter_names = t_filter_names | append: f_clean %}
{% endfor %}
{% assign t_no_load_detail = "" %}
{% if t_filter_names != "" %}{% assign t_no_load_detail = t_filter | append: ": " | append: t_filter_names %}{% endif %}

{% assign t_instance_full = "Österreichischer Polleninformationsdienst, www.polleninformation.at" %}
{% assign t_instance_short = "polleninformation.at" %}

{% comment %} Column headers for the 4 forecast days, in the user's time zone. {% endcomment %}
{% assign utc_offset = trmnl.user.utc_offset | default: 0 | plus: 0 %}
{% assign now_s = "now" | date: "%s" | plus: utc_offset %}
{% assign day3_w = now_s | plus: 172800 | date: "%w" | plus: 0 %}
{% assign day4_w = now_s | plus: 259200 | date: "%w" | plus: 0 %}
{% assign day_labels = t_today | append: "|" | append: t_tomorrow | append: "|" | append: t_weekdays[day3_w] | append: "|" | append: t_weekdays[day4_w] | split: "|" %}

{% assign api_error = error | default: "" | strip %}
{% assign api_error_headline = t_api_error %}
{% if api_error contains "api key" %}{% assign api_error_headline = t_api_key_error %}{% endif %}

{% comment %} The pollen types to show, as ",id,id," so every view applies the same filter. {% endcomment %}
{% assign shown_ids = "," %}
{% assign active_count = 0 %}
{% for entry in entries %}
  {% assign entry_d1 = entry.contamination_1 | default: 0 | plus: 0 %}
  {% if entry_d1 < min_severity %}{% continue %}{% endif %}
  {% if pollen_filter != "" %}
    {% assign entry_name = entry.poll_title | split: " (" | first | downcase %}
    {% assign match = false %}
    {% for f in filter_list %}
      {% assign f_clean = f | strip | downcase %}
      {% if f_clean != "" and entry_name contains f_clean %}{% assign match = true %}{% endif %}
    {% endfor %}
    {% unless match %}{% continue %}{% endunless %}
  {% endif %}
  {% assign shown_ids = shown_ids | append: entry.poll_id | append: "," %}
  {% assign active_count = active_count | plus: 1 %}
{% endfor %}

{% comment %}
  Today-only views: one card per pollen type (or one "no pollen" card), plus the allergy risk
  when it is shown.
{% endcomment %}
{% assign today_cards = active_count | at_least: 1 %}
{% if show_risk %}{% assign today_cards = today_cards | plus: 1 %}{% endif %}
{% assign half_cols = today_cards | at_most: 4 %}
{% if today_cards > 4 %}{% assign half_cols = today_cards | plus: 1 | divided_by: 2 | at_most: 4 %}{% endif %}
{% assign quadrant_cols = today_cards | at_most: 2 %}

{% comment %}
  Forecast rows: a name, then one cell per day. The header row on top carries the day names, so the
  pollen rows below only need their numbers. With show_risk it also holds the allergy risk.
  stacked: false puts the name in front of the cells in landscape and above them in portrait;
  stacked: true always puts it above (narrow views). The name is written once for each place and
  the Framework shows one of them, so the cells keep a grid row of their own that can grow.
{% endcomment %}
{% template row_name %}
<span class="title {{ title_class }}" data-clamp="1">{{ name | escape }}</span>
<span class="label label--small 1bit:text--black">{{ caption }}</span>
{% endtemplate %}

{% template day_header %}
<div class="item">
  <div class="meta bg--white"></div>
  <div class="content grow gap--small">
    {% if stacked %}
      {% if show_risk %}<div class="flex flex--row flex--left flex--center-y gap--small">{% render "row_name", name: t_allergy_risk, caption: t_risk_scale, title_class: title_class %}</div>{% endif %}
      <div class="grid grid--cols-4 gap--small">
    {% else %}
      {% if show_risk %}<div class="hidden portrait:flex flex--row flex--left flex--center-y gap--small">{% render "row_name", name: t_allergy_risk, caption: t_risk_scale, title_class: title_class %}</div>{% endif %}
      <div class="grid grid--cols-6 portrait:grid--cols-4 gap--small">
        <div class="flex flex--col flex--left flex--center-y col--span-2 portrait:hidden">{% if show_risk %}{% render "row_name", name: t_allergy_risk, caption: t_risk_scale, title_class: title_class %}{% endif %}</div>
    {% endif %}
      {% for i in (1..4) %}
        {% assign key = "allergyrisk_" | append: i %}
        {% assign label_index = i | minus: 1 %}
        <div class="flex flex--col flex--center-x gap--xsmall">
          <span class="label label--small 1bit:text--black">{{ day_labels[label_index] }}</span>
          {% if show_risk %}
            <div class="flex flex--col flex--center-x flex--center-y outline w--full p--1 lg:p--2">
              <span class="value {{ value_class }} value--tnums">{{ allergyrisk[key] | default: 0 }}</span>
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>
{% endtemplate %}

{% template pollen_row %}
{% assign d1 = entry.contamination_1 | default: 0 | plus: 0 | at_most: 4 %}
{% assign name = entry.poll_title | split: " (" | first %}
{% assign emphasis = "" %}
{% if d1 >= 3 %}{% assign emphasis = " item--emphasis-3" %}{% elsif d1 == 2 %}{% assign emphasis = " item--emphasis-2" %}{% endif %}
<div class="item{{ emphasis }}{% if fill %} item--shrink{% endif %}">
  <div class="meta"></div>
  <div class="content grow gap--small">
    {% if stacked %}
      <div class="flex flex--row flex--left flex--center-y gap--small">{% render "row_name", name: name, caption: sev_labels[d1], title_class: title_class %}</div>
      <div class="grid grid--cols-4 gap--small{% if fill %} grow{% endif %}">
    {% else %}
      <div class="hidden portrait:flex flex--row flex--left flex--center-y gap--small">{% render "row_name", name: name, caption: sev_labels[d1], title_class: title_class %}</div>
      <div class="grid grid--cols-6 portrait:grid--cols-4 gap--small{% if fill %} grow{% endif %}">
        <div class="flex flex--col flex--left flex--center-y col--span-2 portrait:hidden">{% render "row_name", name: name, caption: sev_labels[d1], title_class: title_class %}</div>
    {% endif %}
      {% for i in (1..4) %}
        {% assign key = "contamination_" | append: i %}
        {% assign d = entry[key] | default: 0 | plus: 0 %}
        {% comment %}
          Every day is a box: 0 is outlined on white, 1-2 get a light gray fill (a light dot pattern in 1-bit,
          so it still differs from 0), 3-4 are solid black.
        {% endcomment %}
        {% assign cell = "outline" %}
        {% assign cell_text = "" %}
        {% if d >= 3 %}
          {% assign cell = "outline bg--black" %}
          {% assign cell_text = " text--white" %}
        {% elsif d >= 1 %}
          {% assign cell = "outline bg--gray-75" %}
        {% endif %}
        <div class="flex flex--col flex--center-x flex--center-y p--1 lg:p--2 {{ cell }}">
          <span class="value {{ value_class }} value--tnums{{ cell_text }}">{{ d }}</span>
        </div>
      {% endfor %}
    </div>
  </div>
</div>
{% endtemplate %}

{% template today_card %}
<div class="item{{ emphasis }}">
  <div class="meta{{ meta_class }}"></div>
  <div class="content grow gap--small">
    <span class="title {{ title_class }}" data-clamp="1">{{ title | escape }}</span>
    <span class="value {{ value_class }} value--tnums">{{ value }}</span>
    {% comment %} An empty caption keeps its line, so every card's title and value line up. {% endcomment %}
    <span class="label label--small 1bit:text--black">{% if caption != "" %}{{ caption }}{% else %}&nbsp;{% endif %}</span>
  </div>
</div>
{% endtemplate %}

{% comment %}
  A full-area message (✓ / ✕ / !). The symbol's glyph fills only the middle of its tall line box, so the
  block looks low when its box is centered. lift adds bottom padding to centre the visible ink instead.
{% endcomment %}
{% template state %}
<div class="flex flex--col flex--center-x flex--center-y gap--small w--full stretch-y {{ lift }}">
  <span class="value {{ symbol_class }}">{{ symbol }}</span>
  <span class="label text--center {{ label_class }}">{{ headline }}</span>
  {% if detail != "" %}<span class="description text--center text--muted 1bit:text--black {{ detail_class }}">{{ detail | escape }}</span>{% endif %}
</div>
{% endtemplate %}

{% comment %}
  polleninformation.at asks public apps to name the data source: "Österreichischer Polleninformationsdienst,
  www.polleninformation.at". The title bar shows that in full and switches to the short form only when the
  full text would be cut (narrow views, portrait, mashup slots, long titles).
{% endcomment %}
{% template title_bar %}
<div class="title_bar">
  <img class="image image--adaptive" src="{{ icon }}" alt="">
  <span class="title">{{ title }}</span>
  <span class="instance" data-short="{{ instance_short | escape }}">{{ instance | escape }}</span>
</div>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    var fitCredits = function () {
      document.querySelectorAll(".title_bar .instance[data-short]").forEach(function (el) {
        if (el.scrollWidth > el.clientWidth + 1) { el.textContent = el.getAttribute("data-short"); }
      });
    };
    if (document.fonts && document.fonts.ready) { document.fonts.ready.then(fitCredits); } else { fitCredits(); }
  });
</script>
{% endtemplate %}
