{% assign title_bar_icon = "data:image/png;base64," %}
{% assign cf = trmnl.plugin_settings.custom_fields_values %}
{% assign entries = contamination | sort: "contamination_1" | reverse %}
{% assign pollen_filter = cf.pollen_filter | default: "" | strip %}
{% assign filter_list = pollen_filter | split: "," %}
{% assign min_severity = cf.min_severity | default: "1" | plus: 0 %}
{% comment %}
  TRMNL saves a switch as "true" or "false". Installs from before the switch existed have no value
  and keep showing the allergy risk.
{% endcomment %}
{% assign show_risk = true %}
{% assign show_risk_value = cf.show_allergy_risk | append: "" | downcase %}
{% if show_risk_value == "false" %}{% assign show_risk = false %}{% endif %}

