{% comment %} Today only: the allergy risk (if shown), then one card per pollen type, larger when there are few. {% endcomment %}
{% if today_cards <= 2 %}
  {% assign title_class = "title--base lg:title--xlarge" %}
  {% assign value_class = "value--xlarge lg:value--xxxlarge" %}
{% elsif today_cards <= 4 %}
  {% assign title_class = "title--small lg:title--large" %}
  {% assign value_class = "value--large lg:value--xxlarge" %}
{% else %}
  {% assign title_class = "title--small lg:title--base" %}
  {% assign value_class = "value--small lg:value--large" %}
{% endif %}

<div class="layout layout--col gap--small">
  {% if api_error != "" %}
    {% render "state", detail_class: "description--large", symbol: "!", lift: "pb--4 lg:pb--5", headline: api_error_headline, detail: api_error, symbol_class: "value--xxlarge lg:value--xxxlarge", label_class: "label--large lg:label--xlarge" %}
  {% elsif entries.size == 0 %}
    {% render "state", detail_class: "description--large", symbol: "✕", lift: "pb--5 lg:pb--6", headline: t_no_data, detail: "", symbol_class: "value--xxlarge lg:value--xxxlarge", label_class: "label--large lg:label--xlarge" %}
  {% elsif active_count == 0 and show_risk == false %}
    {% render "state", detail_class: "description--large", symbol: "✓", lift: "pb--6 lg:portrait:pb--16", headline: t_no_load, detail: t_no_load_detail, symbol_class: "value--xlarge lg:value--giga", label_class: "label--xlarge" %}
  {% else %}
    <div class="grid grid--cols-{{ half_cols }} portrait:grid--cols-{{ quadrant_cols }} gap--small w--full" data-overflow="true" data-overflow-counter="true">
      {% if show_risk %}
        {% render "today_card", title: t_allergy_risk, value: allergyrisk.allergyrisk_1, caption: t_risk_scale, emphasis: "", meta_class: " bg--white", title_class: title_class, value_class: value_class %}
      {% endif %}
      {% if active_count == 0 %}
        {% render "today_card", title: t_no_load_short, value: "✓", caption: t_min_level, emphasis: "", meta_class: "", title_class: title_class, value_class: value_class %}
      {% endif %}
      {% for entry in entries %}
        {% assign entry_key = entry.poll_id | prepend: "," | append: "," %}
        {% unless shown_ids contains entry_key %}{% continue %}{% endunless %}
        {% assign d1 = entry.contamination_1 | default: 0 | plus: 0 | at_most: 4 %}
        {% assign emphasis = "" %}
        {% if d1 >= 3 %}{% assign emphasis = " item--emphasis-3" %}{% elsif d1 == 2 %}{% assign emphasis = " item--emphasis-2" %}{% endif %}
        {% assign name = entry.poll_title | split: " (" | first %}
        {% render "today_card", title: name, value: d1, caption: t_sev[d1], emphasis: emphasis, meta_class: "", title_class: title_class, value_class: value_class %}
      {% endfor %}
    </div>
  {% endif %}
</div>

{% render "title_bar", icon: title_bar_icon, title: t_title_today, instance: t_instance_full, instance_short: t_instance_short %}
