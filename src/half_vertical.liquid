{% comment %} A narrow column: each row puts the name above its four days. {% endcomment %}
{% assign fill = false %}
{% if active_count <= 2 %}
  {% assign fill = true %}
  {% assign title_class = "title--base lg:title--xlarge" %}
  {% assign value_class = "value--xlarge lg:value--xxlarge" %}
  {% assign risk_value_class = "value--large lg:value--xxlarge" %}
{% else %}
  {% assign title_class = "title--small lg:title--base" %}
  {% assign value_class = "value--small lg:value--large" %}
  {% assign risk_value_class = value_class %}
{% endif %}

<div class="layout layout--col layout--top gap--small">
  {% if api_error != "" %}
    {% render "state", symbol: "!", headline: api_error_headline, detail: api_error, symbol_class: "value--xxxlarge lg:value--giga", label_class: "label--large lg:label--xlarge" %}
  {% elsif entries.size == 0 %}
    {% render "state", symbol: "✕", headline: t_no_data, detail: "", symbol_class: "value--xxxlarge lg:value--giga", label_class: "label--large lg:label--xlarge" %}
  {% else %}
    {% render "risk_row", allergyrisk: allergyrisk, day_labels: day_labels, t_allergy_risk: t_allergy_risk, t_risk_scale: t_risk_scale, title_class: title_class, value_class: risk_value_class, stacked: true %}
    <div class="divider"></div>
    {% if active_count == 0 %}
      {% render "state", symbol: "✓", headline: t_no_load, detail: "", symbol_class: "value--xxlarge lg:value--giga", label_class: "label--base lg:label--xlarge" %}
    {% else %}
      {% if fill %}
        <div class="flex flex--col gap--small w--full stretch-y">
      {% else %}
        <div class="columns w--full stretch-y" data-overflow-max-cols="1" data-overflow-counter="true">
          <div class="column">
      {% endif %}
      {% for entry in entries %}
        {% assign entry_key = entry.poll_id | prepend: "," | append: "," %}
        {% unless shown_ids contains entry_key %}{% continue %}{% endunless %}
        {% render "pollen_row", entry: entry, sev_labels: t_sev, title_class: title_class, value_class: value_class, fill: fill, stacked: true %}
      {% endfor %}
      {% unless fill %}</div>{% endunless %}
      </div>
    {% endif %}
  {% endif %}
</div>

{% render "title_bar", icon: title_bar_icon, title: t_title_forecast, instance: t_instance_short %}
